# Copy this file to .env and fill in real values. Never commit .env.
#
# Supabase -> Settings -> Database -> Connection string (URI, "Session" mode)
DATABASE_URL=

# Supabase -> Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (video uploads) -> R2 -> Manage API Tokens
# NOTE: r2_client.py reads these exact names -- R2_ACCESS_KEY_ID (not
# R2_ACCES_KEY_ID) and R2_PUBLIC_URL_BASE (not R2_PUBLIC_URL). Double-check
# your real .env matches these exact names -- a mismatch here means R2
# uploads silently fail with "must be set" errors even though the values
# are present under the wrong key.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
